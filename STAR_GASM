%% ================= GASM FUNCTION =================
function p_out = GASM_1D(p_in, dx, dt, dz, c0)

[Nx,Nt] = size(p_in);

kx = 2*pi*(-Nx/2:Nx/2-1)/(Nx*dx);
f  = (-Nt/2:Nt/2-1)/(Nt*dt);

[KX,F] = ndgrid(kx,f);

omega = 2*pi*F;
k = omega ./ c0;

kz_sq = k.^2 - KX.^2;

H = zeros(size(kz_sq));

prop = kz_sq >= 0;
evan = kz_sq < 0;

H(prop) = exp(-1i * dz .* sign(F(prop)) .* sqrt(kz_sq(prop)));
H(evan) = exp(-abs(dz) .* sqrt(abs(kz_sq(evan))));

P = fftshift(fft2(p_in));
P2 = P .* H;

p_out = real(ifft2(ifftshift(P2)));

end
